# Homeserver VPN IP (the address the VPS nginx connects to). Container is published on BIND_ADDR:5002.
BIND_ADDR=10.0.0.2

# One entry per server: name=token. Name is shown on the page. Generate tokens with: openssl rand -hex 24
PULSE_TOKENS=engg-ai-server=CHANGE_ME_openssl_rand_hex_24

# Password for the page (any username works in the browser prompt).
PULSE_PASSWORD=CHANGE_ME

# Safe range per metric (from ipmitool thresholds). Shown on the page; out of range turns red.
PULSE_LIMITS=system=5:85

# Optional
PULSE_OFFLINE_AFTER=180
PULSE_RETENTION_DAYS=30
